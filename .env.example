# public IP players connect to (used by pvpgn address translation)
PUBLIC_IP=

# aura bot pvpgn account (auto-registered on first login)
AURA_REALM1_USERNAME=binignet_aura
AURA_REALM1_PASSWORD=
# root admins, comma-separated pvpgn usernames
AURA_REALM1_SUDO_USERS=yes

# pvpgn database (optional, defaults shown; shared by pvpgn + pvpgn-db)
# DB_NAME=bnetd
# DB_USER=bnetd
# DB_PASS=secret
