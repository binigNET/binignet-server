# public IP players connect to (used by pvpgn address translation)
PUBLIC_IP=

# aura bot pvpgn account (auto-registered on first login)
AURA_REALM1_USERNAME=bot
AURA_REALM1_PASSWORD=
# root admins, comma-separated pvpgn usernames; include PVPGN_ADMIN_USER for the dashboard
AURA_REALM1_SUDO_USERS=yes,binignet_admin
# aura admins can unhost any lobby; keep PVPGN_ADMIN_USER in the list (dashboard), add yours to do it in-game
# AURA_REALM1_ADMINS=binignet_admin,<your account>

# pvpgn database (optional, defaults shown; shared by pvpgn + pvpgn-db)
# DB_NAME=bnetd
# DB_USER=bnetd
# DB_PASS=secret

# admin dashboard (https://ADMIN_DOMAIN), login user "admin"
# generate: openssl rand -base64 24 | tr -d '/+=' | cut -c1-32
ADMIN_PASSWORD=
# ADMIN_DOMAIN=bnetadmin.bubuyogg.com
# pvpgn account the dashboard logs in with (admin + bot access, see README)
PVPGN_ADMIN_USER=binignet_admin
PVPGN_ADMIN_PASS=
